---
// The NekoTrail wordmark, drawn inline from brand/wordmark/geometry.json so it takes the text colour
// (currentColor) and can animate. With `cat`, the mascot sits on the T. With `reveal`, the hero
// script (WordmarkReveal) draws it out of the night sky once on load.
import { wordmark, inlineCat } from "../lib/brand";
interface Props { class?: string; cat?: boolean; reveal?: boolean; label?: string }
const { class: cls = "", cat = false, reveal = false, label = "NekoTrail" } = Astro.props;
const wm = wordmark();
const [vx, vy, vw, vh] = wm.viewBox.split(" ").map(Number);
// The cat sits on the T's bar: its body (92 of its 140 units) as wide as the bar, paws on the bar top.
const T = { cx: 401, top: -wm.stroke / 2 };
const k = 0.85;
const catBox = { x: T.cx - 60 * k, y: T.top - 113 * k, w: 140 * k, h: 120 * k };
const top = cat ? Math.floor(catBox.y) - 2 : vy;
const viewBox = `${vx} ${top} ${vw} ${vy + vh - top}`;
const catSvg = cat
  ? inlineCat("public/mascot-idle.svg", { cls: "wm-cat", reach: [2.6, 2] })
      .replace("<svg ", `<svg x="${catBox.x}" y="${catBox.y}" width="${catBox.w}" height="${catBox.h}" `)
  : "";
---
<svg
  class:list={["wordmark", cls, { "wm-reveal": reveal }]}
  viewBox={viewBox}
  role="img"
  aria-label={label}
  data-wordmark={reveal ? "" : undefined}
  style={`aspect-ratio:${vw} / ${vy + vh - top}`}
>
  <g class="wm-strokes" fill="none" stroke="currentColor" stroke-width={wm.stroke} stroke-linecap="round" stroke-linejoin="round">
    {wm.letters.map((l) => <path d={l.d} />)}
  </g>
  <path class="wm-star" d={wm.starPath} />
  {cat && <g class="wm-cat-g"><Fragment set:html={catSvg} /></g>}
</svg>
