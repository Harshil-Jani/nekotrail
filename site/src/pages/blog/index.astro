---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { href, formatDate } from "../../lib/site";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Blog" description="Notes on NekoTrail, running coding agents in parallel, git worktrees, and moving from Conductor." path="blog/" image="og/blog.png" imageAlt="The NekoTrail blog">
  <div class="wrap" style="max-width:820px">
    <header class="page-head">
      <h1>Blog</h1>
      <p class="lede">Notes on building NekoTrail and on running coding agents in parallel. <a href={href("rss.xml")}>RSS feed</a>.</p>
    </header>
    <ul class="posts" style="margin-bottom:96px">
      {posts.map((p) => (
        <li>
          <a href={href(`blog/${p.id}/`)}>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <div class="meta"><time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time> · {p.data.author}</div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
