---
// The short version is written for the site. The concept and shortcut tables come from
// docs/MOVING-FROM-CONDUCTOR.md at build time, so they stay in step with the repo's full guide.
import Base from "../layouts/Base.astro";
import Clip from "../components/Clip.astro";
import { SITE, href, readRepoFile } from "../lib/site";
import { renderMarkdown } from "../lib/markdown";
import { softwareApp, faq, breadcrumbs, type Faq } from "../lib/schema";

const md = readRepoFile("docs/MOVING-FROM-CONDUCTOR.md");
/** One "## Heading" section of the guide, without its heading. */
const section = (title: string) => {
  const m = md.match(new RegExp(`^## ${title}\\n([\\s\\S]*?)(?=^## |$(?![\\s\\S]))`, "m"));
  return m ? renderMarkdown(m[1].trim(), "docs") : "";
};
const concepts = section("Concepts");
const shortcuts = section("Shortcuts");
const fullGuide = `${SITE.repo}/blob/main/docs/MOVING-FROM-CONDUCTOR.md`;
const announcement = "https://conductor.build/announcement";
// Dates from Conductor's announcement (checked 8 November 2026).
const timeline = [
  ["4 Nov 2026", "Conductor announces it is joining Meta. New users can't sign up or download the app."],
  ["13 Nov 2026", "Conductor Cloud goes read-only."],
  ["20 Nov 2026", "Conductor starts deleting Cloud data."],
  ["Early 2027", "The Mac app shuts down, and Conductor says it deletes all user data then."],
];
// Shown on the page and sent as FAQPage JSON-LD, so both say exactly the same thing.
const FAQ: Faq = [
  ["What happens to my Conductor worktrees?", "NekoTrail moves each one out of Conductor's folder into ~/nekotrail/workspaces/<repo>/<name> with git worktree move. Git renames the folder, so the branch, its commits and every uncommitted file come along. Nothing is copied or deleted."],
  ["Will I lose uncommitted work?", "No. After each move NekoTrail checks that the branch, the head commit and the uncommitted files are the same as before. Each worktree reads Checked, Moved with a difference to look at, or Not moved with the reason."],
  ["Can I import Conductor Cloud workspaces?", "Not directly. NekoTrail can only read the Conductor app on your Mac. Before 20 November 2026, right-click each Cloud workspace in Conductor and choose Transfer to local, then import."],
  ["What if a worktree won't move?", "It stays exactly where it was, and the sheet says why: a lock, submodules, or a different disk from your home folder. Fix the cause, or commit and push and start a fresh workspace on that branch."],
];
const sections = [
  { id: "timeline", title: "Timeline" },
  { id: "steps", title: "Three steps" },
  { id: "what-moves", title: "What moves" },
  { id: "the-move", title: "The move" },
  { id: "conductor-cloud", title: "Conductor Cloud" },
  { id: "concepts", title: "Concepts" },
  { id: "shortcuts", title: "Shortcuts" },
  { id: "faq", title: "FAQ" },
];
---
<Base
  title="Migrate from Conductor Before It Shuts Down"
  description="Conductor Cloud starts deleting data on 20 November 2026. Move your Conductor repos, workspaces and Claude and Codex chats to NekoTrail in one import. Nothing is deleted."
  path="moving-from-conductor/"
  image="og/moving-from-conductor.png"
  imageAlt="Migrate from Conductor to NekoTrail: repos, workspaces and chats in one import"
  jsonld={[softwareApp(), faq(FAQ), breadcrumbs([["Home", ""], ["Moving from Conductor", "moving-from-conductor/"]])]}
>
  <div class="sky">
    <div class="wrap">
      <header class="page-head sky-head">
        <h1>Moving from Conductor</h1>
        <p class="lede">Your worktrees live in Conductor's folder. Move them out before it shuts down.</p>
        <p style="margin-top:24px"><a class="btn primary" href={href("download/")}>Download NekoTrail</a></p>
      </header>
    </div>
  </div>
  <div class="wrap">
    <div class="with-toc" style="padding-top:48px">
      <aside class="toc" aria-label="On this page">
        <nav>
          <p>On this page</p>
          <ul>{sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}</ul>
        </nav>
      </aside>
      <article class="prose">
        <p>Comparing the two first? See <a href={href("vs/conductor/")}>NekoTrail vs Conductor</a>.</p>

        <h2 id="timeline" style="margin-top:1em">Timeline</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Date</th><th scope="col">What happens</th></tr></thead>
            <tbody>{timeline.map(([d, t]) => <tr><td style="white-space:nowrap">{d}</td><td>{t}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="muted" style="font-size:14px">From <a href={announcement} rel="noopener">Conductor's announcement</a>, checked 8 November 2026.</p>

        <h2 id="steps">Three steps</h2>
        <ol>
          <li><a href={href("download/")}>Install NekoTrail</a> and open it.</li>
          <li>Click <strong>Import from Conductor</strong> (first launch, Welcome, or ⌘K).</li>
          <li>Keep <strong>Move into NekoTrail</strong> picked. Press <strong>Import and move</strong>.</li>
        </ol>
        <Clip name="conductor" label="The Conductor import sheet lists what moves, then shows every worktree moved and checked" title="NekoTrail: Bring your work over from Conductor" />

        <h2 id="what-moves">What moves</h2>
        <ul>
          <li>Repos, with their scripts and custom prompts.</li>
          <li>Active workspaces: name, branch, pin, notes.</li>
          <li>Claude and Codex chats. They continue the same session.</li>
        </ul>
        <p>Not imported: Cloud workspaces, archived workspaces, Conductor's settings and checkpoints.</p>

        <h2 id="the-move">The move</h2>
        <ul>
          <li>Only <code>git worktree move</code>. Nothing in Conductor's folder is deleted.</li>
          <li>Each move is checked: same branch, head commit and uncommitted files.</li>
          <li>Can't move? It stays put, with the reason and the fix.</li>
        </ul>
        <p>New home: <code>~/nekotrail/workspaces/&lt;repo&gt;/&lt;name&gt;</code></p>

        <h2 id="conductor-cloud">Conductor Cloud</h2>
        <p>NekoTrail can't read Cloud. Before 20 November, right-click each Cloud workspace in Conductor, choose <strong>Transfer to local</strong>, then import.</p>

        <h2 id="concepts">Concepts</h2>
        <Fragment set:html={concepts} />

        <h2 id="shortcuts">Shortcuts</h2>
        <Fragment set:html={shortcuts} />

        <h2 id="faq">FAQ</h2>
        {FAQ.map(([q, a]) => (<><h3>{q}</h3><p>{a}</p></>))}

        <p style="margin-top:40px">Every detail, including failed moves: <a href={fullGuide} rel="noopener">the full guide</a>.</p>
        <p class="tm-note">Conductor is a trademark of its owner. NekoTrail is not affiliated with Conductor.</p>
      </article>
    </div>
  </div>
</Base>
