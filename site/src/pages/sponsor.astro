---
import Base from "../layouts/Base.astro";
import { SITE, href } from "../lib/site";
const heart = "M7.655 14.916v-.001h-.002l-.006-.003-.018-.01a22.066 22.066 0 0 1-3.744-2.584C2.045 10.731 0 8.35 0 5.5 0 2.836 2.086 1 4.25 1 5.797 1 7.153 1.802 8 3.02 8.847 1.802 10.203 1 11.75 1 13.914 1 16 2.836 16 5.5c0 2.85-2.044 5.231-3.886 6.818a22.094 22.094 0 0 1-3.433 2.414 7.152 7.152 0 0 1-.31.17l-.018.01-.008.004a.75.75 0 0 1-.69 0Z";
---
<Base
  title="Sponsor"
  description="NekoTrail is free, open source and has no paid tier. Support its development on GitHub Sponsors or Buy Me a Coffee."
  path="sponsor/"
>
  <div class="wrap" style="max-width:820px">
    <header class="page-head">
      <img src={href("brand/mascot-parcel.svg")} alt="" width="72" height="72" style="margin-bottom:20px" />
      <h1>Sponsor NekoTrail</h1>
      <p class="lede">No paid tier, no account. Sponsors pay for the next release.</p>
    </header>

    <div class="dl-grid">
      <section class="dl" aria-labelledby="ghs">
        <h2 id="ghs"><svg width="22" height="22" viewBox="0 0 16 16" style="fill:var(--gh-sponsors)" aria-hidden="true"><path d={heart} /></svg>GitHub Sponsors</h2>
        <p>Monthly or one-time.</p>
        <a class="btn gh-sponsors" href={SITE.githubSponsors} rel="noopener">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d={heart} /></svg>
          Sponsor on GitHub
        </a>
      </section>
      <section class="dl" aria-labelledby="bmc">
        <h2 id="bmc"><img src={href("brand/buymeacoffee-cup.svg")} alt="" width="16" height="23" style="display:inline" />Buy Me a Coffee</h2>
        <p>One-off, by card. No GitHub needed.</p>
        <a class="btn bmc" href={SITE.buyMeACoffee} rel="noopener">
          <img class="cup" src={href("brand/buymeacoffee-cup.svg")} alt="" width="13" height="19" />
          Buy me a coffee
        </a>
      </section>
    </div>

    <section class="prose" aria-labelledby="other" style="margin-bottom:96px">
      <h2 id="other">Free ways to help</h2>
      <ul>
        <li><a href={SITE.repo} rel="noopener">Star the repo</a>.</li>
        <li><a href={SITE.issues} rel="noopener">Report a bug</a>, especially on Linux.</li>
        <li>Send a pull request.</li>
      </ul>
      <p>Sponsoring never unlocks features.</p>
    </section>
  </div>
</Base>
