#!/bin/sh
# A stand-in for the `codex` CLI, for scripts/e2e.sh: `codex exec --json ... <prompt>` prints
# the JSONL a real turn prints. The prompt is the last argument.
case "$1" in --version) echo "codex-cli 0.50.0"; exit 0 ;; esac
for a in "$@"; do prompt="$a"; done
[ -n "${FAKE_AGENT_LOG:-}" ] && printf 'start %s codex %s\n' "$$" "$prompt" >> "$FAKE_AGENT_LOG"
echo "Reading additional input from stdin..." >&2
echo '{"type":"thread.started","thread_id":"thread-fake"}'
echo '{"type":"turn.started"}'
echo '{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"ok"}}'
[ -n "${FAKE_AGENT_LOG:-}" ] && printf 'end %s codex %s\n' "$$" "$prompt" >> "$FAKE_AGENT_LOG"
echo '{"type":"turn.completed","usage":{"input_tokens":10,"output_tokens":1}}'
