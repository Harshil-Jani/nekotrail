{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "NekoTrail",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "Run many coding agents in parallel, each in its own git worktree.",
    "linux": {
      "deb": {
        "recommends": ["git", "xdg-utils"]
      }
    }
  }
}
