{
  "name": "nekotrail",
  "displayName": "nekotrail",
  "description": "See your nekotrail workspaces, open their worktrees and changes, and hand selected code to an agent. Talks to the nekotrail app on your machine only.",
  "version": "0.1.0",
  "publisher": "nekotrail",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Harshil-Jani/nekotrail.git",
    "directory": "extensions/vscode"
  },
  "homepage": "https://github.com/Harshil-Jani/nekotrail/tree/main/extensions/vscode",
  "bugs": "https://github.com/Harshil-Jani/nekotrail/issues",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": ["Other", "SCM Providers"],
  "keywords": ["agents", "claude", "codex", "worktree", "git"],
  "os": ["darwin", "linux"],
  "extensionKind": ["ui", "workspace"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nekotrail",
          "title": "nekotrail",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "nekotrail": [
        {
          "id": "nekotrail.workspaces",
          "name": "Workspaces",
          "icon": "media/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nekotrail.workspaces",
        "contents": "nekotrail isn't running.\n[Start nekotrail](command:nekotrail.start)",
        "when": "nekotrail.state == offline"
      },
      {
        "view": "nekotrail.workspaces",
        "contents": "This extension needs a newer nekotrail. Update nekotrail (Settings, Updates), then reopen it.\n[Try again](command:nekotrail.refresh)",
        "when": "nekotrail.state == outdated"
      },
      {
        "view": "nekotrail.workspaces",
        "contents": "Open a folder from a git repo to see its nekotrail workspaces.",
        "when": "nekotrail.state == noFolder"
      },
      {
        "view": "nekotrail.workspaces",
        "contents": "This repo isn't in nekotrail yet.\n[Add it to nekotrail](command:nekotrail.addRepo)",
        "when": "nekotrail.state == notAdded"
      },
      {
        "view": "nekotrail.workspaces",
        "contents": "No workspaces in this repo yet. Select some code and run \"nekotrail: New task from selection\", or start one in the app.\n[Show nekotrail](command:nekotrail.focusApp)",
        "when": "nekotrail.state == empty"
      },
      {
        "view": "nekotrail.workspaces",
        "contents": "Asking nekotrail...",
        "when": "!nekotrail.state"
      }
    ],
    "commands": [
      {
        "command": "nekotrail.newTaskFromSelection",
        "title": "New task from selection",
        "category": "nekotrail"
      },
      {
        "command": "nekotrail.sendSelection",
        "title": "Send selection to workspace chat",
        "category": "nekotrail"
      },
      {
        "command": "nekotrail.focusApp",
        "title": "Show nekotrail",
        "category": "nekotrail"
      },
      {
        "command": "nekotrail.start",
        "title": "Start nekotrail",
        "category": "nekotrail"
      },
      {
        "command": "nekotrail.refresh",
        "title": "Refresh",
        "category": "nekotrail",
        "icon": "$(refresh)"
      },
      {
        "command": "nekotrail.addRepo",
        "title": "Add this repo to nekotrail",
        "category": "nekotrail"
      },
      {
        "command": "nekotrail.openChanges",
        "title": "Show changes",
        "category": "nekotrail",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "nekotrail.openWindow",
        "title": "Open worktree in new window",
        "category": "nekotrail",
        "icon": "$(empty-window)"
      },
      {
        "command": "nekotrail.openInApp",
        "title": "Show in nekotrail",
        "category": "nekotrail",
        "icon": "$(link-external)"
      },
      {
        "command": "nekotrail.sendSelectionTo",
        "title": "Send selection here",
        "category": "nekotrail"
      },
      {
        "command": "nekotrail.openPr",
        "title": "Open pull request",
        "category": "nekotrail",
        "icon": "$(git-pull-request)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nekotrail.newTaskFromSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "nekotrail.sendSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "nekotrail.openChanges",
          "when": "false"
        },
        {
          "command": "nekotrail.openWindow",
          "when": "false"
        },
        {
          "command": "nekotrail.openInApp",
          "when": "false"
        },
        {
          "command": "nekotrail.sendSelectionTo",
          "when": "false"
        },
        {
          "command": "nekotrail.openPr",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "nekotrail.newTaskFromSelection",
          "when": "editorHasSelection",
          "group": "nekotrail@1"
        },
        {
          "command": "nekotrail.sendSelection",
          "when": "editorHasSelection",
          "group": "nekotrail@2"
        }
      ],
      "view/title": [
        {
          "command": "nekotrail.refresh",
          "when": "view == nekotrail.workspaces",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "nekotrail.openChanges",
          "when": "view == nekotrail.workspaces && viewItem =~ /^workspace/",
          "group": "inline@1"
        },
        {
          "command": "nekotrail.openWindow",
          "when": "view == nekotrail.workspaces && viewItem =~ /^workspace/",
          "group": "inline@2"
        },
        {
          "command": "nekotrail.openInApp",
          "when": "view == nekotrail.workspaces && viewItem =~ /^workspace/",
          "group": "inline@3"
        },
        {
          "command": "nekotrail.openChanges",
          "when": "view == nekotrail.workspaces && viewItem =~ /^workspace/",
          "group": "1_open@1"
        },
        {
          "command": "nekotrail.openWindow",
          "when": "view == nekotrail.workspaces && viewItem =~ /^workspace/",
          "group": "1_open@2"
        },
        {
          "command": "nekotrail.openInApp",
          "when": "view == nekotrail.workspaces && viewItem =~ /^workspace/",
          "group": "1_open@3"
        },
        {
          "command": "nekotrail.openPr",
          "when": "view == nekotrail.workspaces && viewItem =~ /\\.pr/",
          "group": "1_open@4"
        },
        {
          "command": "nekotrail.sendSelectionTo",
          "when": "view == nekotrail.workspaces && viewItem =~ /^workspace/",
          "group": "2_send@1"
        }
      ]
    },
    "configuration": {
      "title": "nekotrail",
      "properties": {
        "nekotrail.click": {
          "type": "string",
          "enum": ["changes", "window"],
          "enumDescriptions": [
            "Show the workspace's changes against its target branch in the diff view.",
            "Open the workspace's worktree folder in a new window."
          ],
          "default": "changes",
          "description": "What clicking a workspace in the nekotrail view does."
        },
        "nekotrail.agent": {
          "type": "string",
          "default": "",
          "description": "Agent for \"New task from selection\" (claude, codex, gemini, ...). Empty uses nekotrail's default, Claude. You still confirm in the app."
        },
        "nekotrail.refreshSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "How often the view and status bar ask nekotrail for news, in seconds."
        }
      }
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts --outdir dist --target node --format cjs --external vscode --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "package": "bun run typecheck && bun run build && vsce package --no-dependencies --out nekotrail.vsix"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "22",
    "@types/vscode": "1.86.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "5.9"
  }
}
